// Judge0 Compiler
RAPID_KEY=
RAPID_HOST=

// ======================================================
// MongoDB connection URL

mongodbURI=mongodb+srv://Name:password@dbname.mongodb.net

// ======================================================
// JWT secrets

ACCESS_TOKEN_SECRET=example_access_token_secret
REFRESH_TOKEN_SECRET=example_refresh_token_secret

// ======================================================
// Socket info

SOCKET_JWT_SECRET=example_socket_jwt_secret
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

// =======================================================
//Email Service

EMAIL_USER=emailId
EMAIL_PASS=passkey

// =======================================================
// website info
APP_URL=http://localhost:3000
NODE_ENV=production

// =======================================================
// Google OAuth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=example_nextauth_secret

// =======================================================
// Redis info

REDIS_URL=redis://default:password@redis-host:port

// =======================================================
// UpStash redis info

UPSTASH_REDIS_REST_URL=https://something.upstash.io
UPSTASH_REDIS_REST_TOKEN=randomToken

// =======================================================
// Vercel MUX connection Info
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
